#include <winver.h>

// Windows manifest: modern control styles and correct screen-size detection
// on scaled displays.
1 24 "launcher.manifest"

// Application icon: an original drawing (a hexagon in the menu colours of the
// game with a play mark), not the game's own artwork.
1 ICON "launcher.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,5,0,0
PRODUCTVERSION 1,5,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Ridge Racer 6 PC launcher (unofficial)"
      VALUE "ProductName", "Ridge Racer 6 PC recompilation (unofficial test build)"
      VALUE "FileVersion", "1.5.0.0"
      VALUE "ProductVersion", "1.5.0.0"
      VALUE "OriginalFilename", "RR6 Launcher.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
