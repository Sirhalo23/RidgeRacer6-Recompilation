# Opt-in, pinned POSIX audio adapter. SDK sources/headers stay untouched.
if(NOT UNIX OR NOT TARGET rexcore OR NOT TARGET rexaudio OR NOT TARGET rexruntime)
    message(FATAL_ERROR "RR6_NATIVE_AUDIO_WAIT requires a POSIX SDK source build")
endif()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
get_target_property(native_audio_sdk_dir rexcore SOURCE_DIR)
get_filename_component(native_audio_sdk_root "${native_audio_sdk_dir}/../.." ABSOLUTE)
set(native_audio_script "${CMAKE_CURRENT_SOURCE_DIR}/tools/prepare_native_audio_wait.py")
set(native_audio_output "${CMAKE_CURRENT_BINARY_DIR}/native_audio")
execute_process(COMMAND "${Python3_EXECUTABLE}" "${native_audio_script}" "${native_audio_sdk_root}" "${native_audio_output}"
    RESULT_VARIABLE native_audio_result ERROR_VARIABLE native_audio_error)
if(NOT native_audio_result EQUAL 0)
    message(FATAL_ERROR "Native audio integration refused: ${native_audio_error}")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${native_audio_script}" "${native_audio_sdk_root}/src/core/threading_posix.cpp"
    "${native_audio_sdk_root}/src/audio/audio_system.cpp")
foreach(native_audio_part core audio)
    if(native_audio_part STREQUAL "core")
        set(native_audio_target rexcore)
        set(native_audio_file threading_posix.cpp)
    else()
        set(native_audio_target rexaudio)
        set(native_audio_file audio_system.cpp)
    endif()
    get_target_property(native_audio_sources ${native_audio_target} SOURCES)
    set(native_audio_original ${native_audio_sources})
    list(FILTER native_audio_original INCLUDE REGEX "(^|/)${native_audio_file}$")
    list(LENGTH native_audio_original native_audio_count)
    if(NOT native_audio_count EQUAL 1)
        message(FATAL_ERROR "Cannot identify original ${native_audio_file}")
    endif()
    list(REMOVE_ITEM native_audio_sources "${native_audio_original}")
    list(APPEND native_audio_sources "${native_audio_output}/${native_audio_file}")
    set_property(TARGET ${native_audio_target} PROPERTY SOURCES "${native_audio_sources}")
    set_source_files_properties("${native_audio_output}/${native_audio_file}" TARGET_DIRECTORY ${native_audio_target}
        PROPERTIES INCLUDE_DIRECTORIES "${native_audio_sdk_root}/src/${native_audio_part}")
    target_include_directories(${native_audio_target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
    target_link_libraries(${native_audio_target} PRIVATE recomp::native)
endforeach()
# Single definition in the runtime; core and audio share the same TLS domain.
target_sources(rexcore PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/native_audio_wait.cpp")
target_link_libraries(rexruntime PRIVATE recomp::native)
option(RR6_NATIVE_AUDIO_WAIT_TESTS "Build tests against actual SDK audio wait handles" ON)
if(RR6_NATIVE_AUDIO_WAIT_TESTS)
    enable_testing()
    add_executable(rr6_native_audio_wait_tests "${CMAKE_CURRENT_SOURCE_DIR}/native/tests/native_audio_wait_tests.cpp")
    target_include_directories(rr6_native_audio_wait_tests PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
    target_link_libraries(rr6_native_audio_wait_tests PRIVATE rex::runtime recomp::native)
    add_test(NAME rr6_native_audio_wait COMMAND rr6_native_audio_wait_tests)
    set_tests_properties(rr6_native_audio_wait PROPERTIES TIMEOUT 45)
    add_test(NAME rr6_native_audio_seam
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/test_prepare_native_audio_wait.py")
    set_tests_properties(rr6_native_audio_seam PROPERTIES
        ENVIRONMENT "RR6_NATIVE_AUDIO_TEST_SDK=${native_audio_sdk_root}")
endif()
